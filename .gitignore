# ==============================================================================
# 0. GLOBAL MACOS SYSTEM JUNK (Force ignore right at the top)
# ==============================================================================
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# ==============================================================================
# 1. LOCAL AI, VECTOR DATABASES & MCP STATE (Tailored for your stack)
# ==============================================================================
# Traditional Transactional Databases (SQLite)
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal
rag_engine/storage/chat_history.db

# Vector Databases & Compiled Embedding Indices
# (Catches ChromaDB, FAISS directories, and generic search weights)
**/storage/vector_index/
**/chroma/
.chroma/
*.idx
*.index
*.pkl
*.pickle

# Local LLM Weights, Safetensors & Model Directories
# (Keeps Hugging Face / MLX local caching artifacts out of GitHub)
*.bin
*.safetensors
*.gguf
**/mlx-community/
.cache/huggingface/

# Model Context Protocol (MCP) Runtime logs & configurations
.mcp/
mcp-events.log
*.mcp.json

# ==============================================================================
# 2. CORE PYTHON RUNTIMES & DEPENDENCIES
# ==============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.so

# Environments (Virtual environments managed by uv, venv, or poetry)
.env
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Package managers lock/config preferences
# (Uncomment if you want to explicitly ignore lock files, though usually tracked)
# uv.lock